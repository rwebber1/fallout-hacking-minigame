# Copy this file to .env and fill in your own values. Never commit .env.

# Port the portal server listens on. This is what you put into the UDM Pro's
# "External Portal Server" URL field, e.g. http://192.168.10.5:8080
PORT=8080

# --- UniFi controller connection ---
# Base URL of your UDM Pro's Network application, e.g. https://192.168.1.1
UNIFI_CONTROLLER_URL=https://192.168.1.1

# UDM Pro consoles use a self-signed certificate by default. Set to "true" to
# accept it. If you've installed a real cert, set this to "false".
UNIFI_INSECURE_TLS=true

# Which local API to use to authorize guests: "v1" (newer, API-key based) or
# "legacy" (older cmd/stamgr controller API). Try v1 first.
UNIFI_API_MODE=v1

# --- v1 (Integrations) API ---
# Settings -> Control Plane -> Integrations in the UniFi Network app.
UNIFI_API_KEY=
# Site ID (UUID) - the Integrations page or a GET to
# {UNIFI_CONTROLLER_URL}/proxy/network/integrations/v1/sites will show this.
UNIFI_SITE_ID=

# --- legacy API (only used when UNIFI_API_MODE=legacy) ---
# A dedicated local admin account - don't reuse your primary UI account.
UNIFI_USERNAME=
UNIFI_PASSWORD=
# Short site name as shown in the controller URL when viewing that site (often "default").
UNIFI_SITE=default

# How long an authorized guest stays online before the terminal gate applies again.
SESSION_MINUTES=480
